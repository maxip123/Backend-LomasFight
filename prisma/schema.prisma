datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
model clientes {
  id_cliente            Int         @id @default(autoincrement())
  nombre                String      @db.VarChar(100)
  apellido              String      @db.VarChar(100)
  dni                   String?     @unique @db.VarChar(20)
  fecha_nacimiento      DateTime?   @db.Date
  grupo_sanguineo       String?     @db.VarChar(10)
  id_disciplina         Int
  id_profesor_que_cargo Int?
  fecha_ultimo_pago     DateTime?   @db.Date
  activo                Boolean?    @default(true)
  disciplinas           disciplinas @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction, map: "fk_disciplina_cliente")
  profesores            profesores? @relation(fields: [id_profesor_que_cargo], references: [id_profesor], onDelete: NoAction, onUpdate: NoAction, map: "fk_profesor_cargo")
  pagos                 pagos[]
}

model disciplinas {
  id_disciplina     Int          @id @default(autoincrement())
  nombre_disciplina String       @db.VarChar(150)
  cuota             Decimal      @db.Decimal(10, 2)
  descripcion       String?
  img_banner        String?      @db.VarChar(255)
  img_preview       String?      @db.VarChar(255)
  activo            Boolean?     @default(true)
  clientes          clientes[]
  horarios          horarios[]
  pagos             pagos[]
  profesores        profesores[]
}

model horarios {
  id_horario    Int         @id @default(autoincrement())
  dia_y_hora    DateTime    @db.Timestamptz(6)
  id_disciplina Int
  id_profesor   Int
  activo        Boolean?    @default(true)
  disciplinas   disciplinas @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction, map: "fk_disciplina_horario")
  profesores    profesores  @relation(fields: [id_profesor], references: [id_profesor], onDelete: NoAction, onUpdate: NoAction, map: "fk_profesor_horario")
}

model pagos {
  id_pago       Int         @id @default(autoincrement())
  id_cliente    Int
  id_disciplina Int
  monto         Decimal     @db.Decimal(10, 2)
  fecha_pago    DateTime?   @default(now()) @db.Timestamptz(6)
  activo        Boolean?    @default(true)
  clientes      clientes    @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente_pago")
  disciplinas   disciplinas @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction, map: "fk_disciplina_pago")
}

model profesores {
  id_profesor   Int         @id @default(autoincrement())
  nombre        String      @db.VarChar(100)
  apellido      String      @db.VarChar(100)
  id_disciplina Int
  activo        Boolean?    @default(true)
  clientes      clientes[]
  horarios      horarios[]
  disciplinas   disciplinas @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction, map: "fk_disciplina_profesor")
}

model usuarios {
  id_usuario         Int      @id @default(autoincrement())
  rol                String   @db.VarChar(50)
  nombre_usuario     String   @db.VarChar(150)
  mail_usuario       String   @unique @db.VarChar(255)
  contrasena_usuario String   @db.VarChar(255)
  activo             Boolean? @default(true)
}
